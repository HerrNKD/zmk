#include <dt-bindings/zmk/matrix_transform.h>

#include "IVP60-layouts.dtsi"

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,physical_layout = &physical_layout0;
	};
	
	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <17>;
		rows = <5>;
		// [ L00 ] [ L01 ] [ L02 ] [ L03 ] [ L04 ] [ L05 ] [ L06 ] [ L07 ]                     [ R18 ] [ R08 ] [ R07 ] [ R06 ] [ R05 ] [ R04 ] [ R03 ] [ R02 ] [ R01 ] [ R00 ]
		// [ L10 ] [    L11   ] [ L12 ] [ L13 ] [ L14 ] [ L15 ] [ L16 ] [ L17 ]                   [ R28 ] [ R17 ] [ R16 ] [ R15 ] [ R14 ] [ R13 ] [ R12 ] [ R11 ] [  R10     ]
		// [ L20 ] [     L21     ] [ L22 ] [ L23 ] [ L24 ] [ L25 ] [ L26 ] [ L27 ]                 [ R38 ] [ R27 ] [ R26 ] [ R25 ] [ R24 ] [ R23 ] [ R22 ] [ R21 ] [  R20    ]
		// [ L30 ] [       L31        ] [ L32 ] [ L33 ] [ L34 ] [ L35 ] [ L36 ] [ L37 ]               [ R37 ] [ R36 ] [ R35 ] [ R34 ] [ R33 ] [ R32 ] [ R31 ] [      R30     ]
		// [ L40 ] [   L41   ] [   L42   ] [  L43 ] [ L44 ] [        L45        ] [ L46 ]              [ R45 ] [       R44       ] [  R43  ] [  R42  ] [  R41  ] [    R40    ]
		map = <                                                                 
		   RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)                 RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16)
		   RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)                 RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16)
		   RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)                 RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15) RC(2,16)
		   RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)                 RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15) RC(3,16)
		   RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)                                                  RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15) RC(4,16)
		>;
	};
	
	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		wakeup-source;
		diode-direction = "col2row";
		row-gpios = <&feather_header 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // A0, RA
		          , <&feather_header 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // A1, RB
		          , <&feather_header 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // A2, RC
		          , <&feather_header 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // A3, RD
		          , <&feather_header 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // A4, RE
		          ;
	};
	
};
