#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {

    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            bindings = <
                &kp A      &kp C
                &to 1      &kp D
            >;
        };

        second_layer  { // Layer 1
            bindings = <
                &kp E      &kp F
                &to 0      &kp G
            >;
        };

    };
};
